# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
    desc "Push a new beta build to TestFlight"
    lane :buildtest do
      setup_ci
      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_KEY_ID"],
        issuer_id: ENV["APP_STORE_KEY_ISSUER_ID"],
        key_content: ENV["APP_STORE_API_KEY"],
        in_house: false
      )
      match(type: "appstore", api_key: api_key, readonly: false)
      build_app(workspace: "App.xcworkspace", scheme: "App") # Change name of workspace
    end
    lane :beta do
        setup_ci
        api_key = app_store_connect_api_key(
          key_id: ENV["APP_STORE_KEY_ID"],
          issuer_id: ENV["APP_STORE_KEY_ISSUER_ID"],
          key_content: ENV["APP_STORE_API_KEY"],
          in_house: false, # optional but may be required if using match/sigh
          duration: 500
        )
        match(type: "appstore", api_key: api_key, readonly: false)
        build_app(workspace: "App.xcworkspace", scheme: "App") # Change name of workspace
        upload_to_testflight(
          api_key: api_key,
          changelog: ENV["CHANGELOG"] || "New features and enhancements are continously added to the app!",
          skip_waiting_for_build_processing: true,
          skip_submission: true,
          apple_id: ENV["APP_STORE_APP_APPLE_ID"],
          app_identifier: ENV["APP_STORE_APP_IDENTIFIER"],
          team_id: ENV["APP_STORE_TEAM_ID"],
        )
    end
    lane :prod do
        setup_ci
        api_key = app_store_connect_api_key(
            key_id: ENV["APP_STORE_KEY_ID"],
            issuer_id: ENV["APP_STORE_KEY_ISSUER_ID"],
            key_content: ENV["APP_STORE_API_KEY"],
            in_house: false # optional but may be required if using match/sigh
        )
        match(type: "appstore", api_key: api_key, readonly: false)
        build_app(workspace: "App.xcworkspace", scheme: "App") # Change name of workspace
        upload_to_app_store(
          api_key: api_key,
          force: true, # Set to true to skip verification of HTML preview
          skip_metadata: true,# pass a specific value to the iTMSTransporter -itc_provider option
          skip_screenshots: true,
          submit_for_review: false,
          precheck_include_in_app_purchases: false,
          app_identifier: ENV["APP_STORE_APP_IDENTIFIER"],
          team_id: ENV["APP_STORE_TEAM_ID"]
        )
        submit(api_key: api_key)
    end
    desc "Submit this version's latest build for review, released once Apple approves"
    lane :submit do |options|
        api_key = options[:api_key] || app_store_connect_api_key(
            key_id: ENV["APP_STORE_KEY_ID"],
            issuer_id: ENV["APP_STORE_KEY_ISSUER_ID"],
            key_content: ENV["APP_STORE_API_KEY"],
            in_house: false
        )
        # Ruby in a lane runs in ios/App/fastlane.
        version = JSON.parse(File.read("../../../package.json"))["version"]
        notes = File.read(File.join(ENV.fetch("STORE_NOTES_DIR"), "app-store.txt"))
        app = Spaceship::ConnectAPI::App.find(ENV["APP_STORE_APP_IDENTIFIER"])
        edit = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
        unless edit&.version_string == version
          UI.user_error!("App Store Connect has no #{version} to submit: the prod lane uploads its build first")
        end
        # fastlane's "default" notes only reach the languages of metadata
        # folders, which the repo doesn't keep: name each of the version's.
        locales = edit.get_app_store_version_localizations.map(&:locale)
        upload_to_app_store(
          api_key: api_key,
          app_version: version,
          skip_binary_upload: true,
          skip_screenshots: true,
          release_notes: locales.to_h { |locale| [locale, notes] },
          submit_for_review: true,
          automatic_release: true,
          # Precheck flags a copyright without the current year.
          copyright: "#{Time.now.year} Simon Lefort",
          force: true,
          precheck_include_in_app_purchases: false,
          # Exempt: HTTPS and the system's WebCrypto only. Info.plist says so
          # from 2.0.1 on; a build from before needs the answer here.
          submission_information: { export_compliance_uses_encryption: false },
          app_identifier: ENV["APP_STORE_APP_IDENTIFIER"],
          team_id: ENV["APP_STORE_TEAM_ID"]
        )
    end
    lane :test do
        api_key = app_store_connect_api_key(
          key_id: ENV["APP_STORE_KEY_ID"],
          issuer_id: ENV["APP_STORE_KEY_ISSUER_ID"],
          key_filepath: "./AuthKey.p8",
          in_house: false, # optional but may be required if using match/sigh
        )
        upload_to_testflight(changelog: ENV["CHANGELOG"] || "New features and enhancements are continously added to the app!")
    end
end
